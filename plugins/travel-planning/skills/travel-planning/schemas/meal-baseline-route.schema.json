{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/meal-baseline-route.schema.json",
  "title": "Meal direct baseline route",
  "type": "object",
  "required": [
    "id",
    "meal_id",
    "from_anchor",
    "to_anchor",
    "mode",
    "routing_policy",
    "departure_at",
    "distance_meters",
    "duration_minutes",
    "door_to_door_minutes",
    "map_url",
    "checked_at",
    "source_ids"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"},
    "meal_id": {"type": "string", "minLength": 1},
    "from_anchor": {"$ref": "#/$defs/anchor"},
    "to_anchor": {"$ref": "#/$defs/anchor"},
    "mode": {"type": "string", "minLength": 1},
    "routing_policy": {"type": "string", "minLength": 1},
    "departure_at": {"type": "string", "minLength": 1},
    "distance_meters": {"type": "number", "minimum": 0},
    "duration_minutes": {"type": "number", "minimum": 0},
    "door_to_door_minutes": {"type": "number", "minimum": 0},
    "map_url": {"type": "string", "pattern": "^https://"},
    "checked_at": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "anchor": {
      "type": "object",
      "required": ["name", "coordinates", "coordinate_system"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "coordinates": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?\\s*,\\s*-?[0-9]+(?:\\.[0-9]+)?$"},
        "coordinate_system": {"enum": ["GCJ-02", "WGS84"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
