{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/meal-route-evaluation.schema.json",
  "title": "Meal candidate two-leg route evaluation",
  "type": "object",
  "required": [
    "id",
    "meal_id",
    "restaurant_id",
    "baseline_route_id",
    "comparison_basis",
    "from_previous",
    "to_next",
    "total_door_to_door_minutes",
    "baseline_door_to_door_minutes",
    "detour_minutes",
    "checked_at",
    "source_ids"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"},
    "meal_id": {"type": "string", "minLength": 1},
    "restaurant_id": {"type": "string", "minLength": 1},
    "baseline_route_id": {"type": "string", "minLength": 1},
    "comparison_basis": {
      "type": "object",
      "required": ["mode", "routing_policy", "departure_at"],
      "properties": {
        "mode": {"type": "string", "minLength": 1},
        "routing_policy": {"type": "string", "minLength": 1},
        "departure_at": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "from_previous": {"$ref": "#/$defs/leg"},
    "to_next": {"$ref": "#/$defs/leg"},
    "total_door_to_door_minutes": {"type": "number", "minimum": 0},
    "baseline_door_to_door_minutes": {"type": "number", "minimum": 0},
    "detour_minutes": {"type": "number", "minimum": 0},
    "access": {"type": "object"},
    "checked_at": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "leg": {
      "type": "object",
      "required": ["route_id", "origin", "destination", "distance_meters", "duration_minutes", "door_to_door_minutes", "map_url"],
      "properties": {
        "route_id": {"type": "string", "minLength": 1},
        "origin": {"$ref": "#/$defs/endpoint"},
        "destination": {"$ref": "#/$defs/endpoint"},
        "distance_meters": {"type": "number", "minimum": 0},
        "duration_minutes": {"type": "number", "minimum": 0},
        "door_to_door_minutes": {"type": "number", "minimum": 0},
        "map_url": {"type": "string", "pattern": "^https://"}
      },
      "additionalProperties": true
    },
    "endpoint": {
      "type": "object",
      "required": ["name", "coordinates"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "coordinates": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?\\s*,\\s*-?[0-9]+(?:\\.[0-9]+)?$"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
