      "description": "Synthetic: first committed eligible fare",
      "value": 12,
      "unit": "AUD",
      "status": "verified"
    },
    "ride-two": {
      "description": "Synthetic: second committed eligible fare",
      "value": 8,
      "unit": "AUD",
      "status": "verified"
    },
    "ride-three": {
      "description": "Synthetic: third committed eligible fare",
      "value": 9,
      "unit": "AUD",
      "status": "verified"
    },
    "cap": {
      "description": "Synthetic: applicable daily cap",
      "value": 30,
      "unit": "AUD",
      "status": "verified"
    },
    "pass-price": {
      "description": "Synthetic: comparable day pass covering the same rides",
      "value": 24,
      "unit": "AUD",
      "status": "verified"
    }
  },
  "rules": [
