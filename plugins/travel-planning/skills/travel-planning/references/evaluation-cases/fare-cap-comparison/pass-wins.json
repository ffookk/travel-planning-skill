    },
    {
      "id": "calculation",
      "kind": "quantity",
      "expression": {
        "op": "min",
        "args": [
          {
            "op": "sum",
            "args": [
              {
                "fact": "ride-one"
              },
              {
                "fact": "ride-two"
              },
              {
