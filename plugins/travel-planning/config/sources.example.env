# Copy the fields you need to either:
#   config/sources.local.env (source checkout, preferred for local development), or
#   ~/.config/travel-planning/sources.local.env (installed-plugin fallback).
# Never commit sources.local.env.

# AMap Web Service key. AMAP_API_KEY remains a supported compatibility alias.
AMAP_MAPS_API_KEY=

# Optional; FlyAI base search can work without credentials.
FLYAI_API_KEY=
FLYAI_SIGN_SECRET=
FLYAI_PROFILE=

# Required by both Variflight MCP servers.
VARIFLIGHT_API_KEY=
